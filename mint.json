{
  "$schema": "https://mintlify.com/schema.json",
  "name": "Voight",
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "href": "https://voight.xyz"
  },
  "favicon": "/favicon.svg",
  "colors": {
    "primary": "#e5e6ea",
    "light": "#f0f1f3",
    "dark": "#bcbfc4",
    "anchors": {
      "from": "#e5e6ea",
      "to": "#bcbfc4"
    },
    "background": {
      "dark": "#0a0a0f"
    }
  },
  "theme": "venus",
  "modeToggle": {
    "default": "dark"
  },
  "font": {
    "headings": { "family": "Inter" },
    "body": { "family": "Inter" }
  },
  "topbarLinks": [
    {
      "name": "Dashboard",
      "url": "https://voight.xyz/dashboard"
    },
    {
      "name": "Explorer",
      "url": "https://voight.xyz/explore"
    }
  ],
  "topbarCtaButton": {
    "name": "Get started",
    "url": "https://voight.xyz/dashboard"
  },
  "anchors": [
    {
      "name": "GitHub",
      "icon": "github",
      "url": "https://github.com/Voightxyz"
    },
    {
      "name": "npm",
      "icon": "npm",
      "url": "https://www.npmjs.com/package/@voightxyz/sdk"
    }
  ],
  "navigation": [
    {
      "group": "Getting started",
      "pages": [
        "introduction",
        "quickstart"
      ]
    },
    {
      "group": "Concepts",
      "pages": [
        "concepts/agents",
        "concepts/events",
        "concepts/traces",
        "concepts/sessions",
        "privacy/overview"
      ]
    },
    {
      "group": "AI Apps",
      "pages": [
        "ai-apps/overview",
        "ai-apps/wizard",
        "concepts/per-user-spend",
        "ai-apps/tracing",
        "ai-apps/openai",
        "ai-apps/anthropic",
        "ai-apps/vercel-ai"
      ]
    },
    {
      "group": "Install paths",
      "pages": [
        "sdk/library-mode",
        "sdk/http-api"
      ]
    },
    {
      "group": "Reference",
      "pages": [
        "api-reference/events",
        "api-reference/agents",
        "api-reference/me",
        "privacy/pii-patterns",
        "privacy/data-handling"
      ]
    },
    {
      "group": "Resources",
      "pages": [
        "pricing",
        "changelog"
      ]
    }
  ],
  "footerSocials": {
    "twitter": "https://x.com/voightxyz",
    "github": "https://github.com/Voightxyz",
    "website": "https://voight.xyz"
  },
  "feedback": {
    "thumbsRating": true,
    "suggestEdit": true
  },
  "search": {
    "prompt": "Search the Voight docs"
  }
}
